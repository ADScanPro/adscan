                                                                                         \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2502\u001b[0m      \u001b[36m\u203a\u001b[0m  domain FQDN                                                                                                                                                                \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2502\u001b[0m      \u001b[36m\u203a\u001b[0m  DC or PDC IP                                                                                                                                                               \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2502\u001b[0m      \u001b[36m\u203a\u001b[0m  DC hostname (FQDN)                                                                                                                                                         \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2502\u001b[0m                                                                                                                                                                                    \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2502\u001b[0m                                                                                                                                                                                    \u001b[34m\u2502\u001b[0m\r\n\u001b[34m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500