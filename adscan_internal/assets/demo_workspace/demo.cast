                                                                                          \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m    Type       Password                                                                                                                                                             \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                                                                                                    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m  \u001b[2mCredentials will be verified live against the target domain.\u001b[0m                                                                                                                      \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                                                                                                                                    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250