                                                                                             \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m      Domain:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37messos.local                                      \u001b[0m                                                                                                                  \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m     Targets:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37m192.168.180.12                                   \u001b[0m                                                                                                                  \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m      Shares:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mSYSVOL, NETLOGON, Replication, SYSVOL_DFSR, NtFrs\u001b[0m                                                                                                                  \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36mSession Type:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mAdministrative Session                           \u001b[0m                                                                                                                  \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m      Engine:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mnative_gpp_walker (cpassword + autologon)        \u001b[0m                                                                                                                  \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m                                                                                                                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u250