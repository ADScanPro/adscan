[53.323549, "o", "\u001b[32m\u256d\u2500\u001b[0m\u001b[32m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[32m \u001b[0m\u001b[1;36m\ud83d\udee1\ufe0f  Posture Probe Summary \u00b7 essos.local\u001b[0m\u001b[32m \u001b[0m\u001b[32m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[32m\u2500\u256e\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[1m6 probes complete\u001b[0m\u001b[2m \u00b7 \u001b[0m\u001b[1;32m2 hardening controls now confirmed\u001b[0m\u001b[2m \u00b7 \u001b[0m\u001b[2m0.4s\u001b[0m     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[1mDetected hardening\u001b[0m                                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[32m\u2713   \u001b[0m  Non-default Kerberos salt  \u001b[2mhigh\u001b[0m\u001b[2m  \u001b[0m\u001b[1;32m\u26a1 NEW\u001b[0m                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[32m\u2713   \u001b[0m  SMB signing required       \u001b[2mhigh\u001b[0m\u001b[2m  \u001b[0m\u001b[1;32m\u26a1 NEW\u001b[0m                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[1;33mPermissive (no hardening detected)\u001b[0m                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[2m\u2717   \u001b[0m  \u001b[2mLDAPS available                 \u001b[0m                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[2m\u2717   \u001b[0m  \u001b[2mRC4 Kerberos encryption accepted\u001b[0m                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[2m\u2717   \u001b[0m  \u001b[2mNTLM authentication accepted    \u001b[0m                            \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[1;32m\u26a1 \u001b[0m\u001b[1;32mAdapting all subsequent operations to this complete posture.\u001b[0m   \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m   \u001b[2mRe-probe automatically in 24h, or anytime via:\u001b[0m                    \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m     \u001b[1madscan posture probe essos.local\u001b[0m                                \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2502\u001b[0m                                                                     \u001b[32m\u2502\u001b[0m\r\n\u001b[32m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
