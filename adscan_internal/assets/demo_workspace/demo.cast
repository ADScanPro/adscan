                 \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m         PDC:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37m192.168.180.12                                                                 \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36mPDC Hostname:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mmeereen                                                                        \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m    Username:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37madscan                                                                         \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m    Listener:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37m192.168.180.1                                                                  \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m     Trigger:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mNative coercion to SMB listener                                                \u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m  \u001b[1;36m       OPSEC:\u001b[0m\u001b[1;36m  \u001b[0m\u001b[37mCoercion to a listener may be flagged by Defender for Identity, MDI, or SOC NDR\u001b[0m                                                                                    \u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001