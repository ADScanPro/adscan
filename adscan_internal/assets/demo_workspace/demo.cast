[71.93095000000001, "o", "\u001b[33m\u256d\u2500\u001b[0m\u001b[33m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[33m Recommended Important Port Scan \u001b[0m\u001b[33m\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u001b[0m\u001b[33m\u2500\u256e\u001b[0m\r\n\u001b[33m\u2502\u001b[0m                                                                                                           \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mThis Nmap scan is recommended for small scopes.\u001b[0m                                                          \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mDomain: essos.local\u001b[0m                                                                                      \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mResolved IPs queued: 2\u001b[0m                                                                                   \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mImportant TCP ports: 21,22,53,80,88,389,443,445,1433,3389,5900,5985\u001b[0m                                      \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m                                                                                                           \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mWhy run it now:\u001b[0m                                                                                          \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37m- quickly confirms which hosts expose important AD services\u001b[0m                                              \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37m- shows which resolved IPs do not answer from the current vantage\u001b[0m                                        \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37m- helps determine whether pivoting may be needed later\u001b[0m                                                   \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m                                                                                                           \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m  \u001b[37mThis is still active network traffic, but the scope is small enough that the value is usually worth it.\u001b[0m  \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2502\u001b[0m                                                                                                           \u001b[33m\u2502\u001b[0m\r\n\u001b[33m\u2570\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256f\u001b[0m\r\n"]
