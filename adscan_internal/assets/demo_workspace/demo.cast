[25.541737, "o", "\u001b[3m                        Installation Status Summary                        \u001b[0m\r\n\u001b[38;5;45m\u256d\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u252c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u256e\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[1;38;5;45mComponent           \u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[38;5;45m\u2502\u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[1;38;5;45m Status  \u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[38;5;45m\u2502\u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[1;38;5;45mDetails                             \u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u251c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u253c\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2524\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[1;38;5;45mPython Virtual Env  \u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[38;5;45m\u2502\u001b[0m \u001b[32m\u2713 Success\u001b[0m \u001b[38;5;45m\u2502\u001b[0m\u001b[2m \u001b[0m\u001b[2mNot required (ADscan Docker runtime)\u001b[0m\u001b[2m \u001b[0m\u001b[38;5;45m\u2502\u001b[0m\r\n\u001b[38;5;45m\u2502\u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[1;38;5;45mSystem Python       \u001b[0m\u001b[1;38;5;45m \u001b[0m\u001b[38;5;45m\u25